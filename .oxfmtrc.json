{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "examples/**",
    "tests/fixtures/**",
    ".seo-rea/**",
    "seo-rea-runs/**",
    "CHANGELOG.md",
    "package-lock.json"
  ]
}
