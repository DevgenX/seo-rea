{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DevgenX/seo-rea/blob/main/docs/error-contract.schema.json",
  "title": "seo-rea error payload",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "hint", "exitCode"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "USAGE",
            "INVALID_INPUT",
            "RUN_EXISTS",
            "BUDGET_REFUSED",
            "SCHEMA_INVALID",
            "NOT_FOUND",
            "FETCH_FAILED",
            "CRAWL_STATE_INVALID",
            "DIFF_INCOMPATIBLE",
            "DEPENDENCY_MISSING",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "exitCode": {
          "enum": [1, 2]
        }
      }
    }
  }
}
